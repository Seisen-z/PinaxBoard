# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# Never paste access tokens or other credentials into comments in this file.

# Project URL and anon key from the Supabase dashboard → Project Settings → API.
# Both are safe to expose to the browser; Row Level Security is what protects
# user data, never the key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely, so it must never be prefixed
# NEXT_PUBLIC_ and never imported into a client component. Used by the signup
# OTP rate limiter and the daily health check.
SUPABASE_SERVICE_ROLE_KEY=

# Set to "false" to disable the in-process daily database health check.
# TACKLY_DAILY_HEALTH_CHECK=false

# Email sender (see docs/EMAIL_VERIFICATION.md). Use an app password, never the
# account password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
